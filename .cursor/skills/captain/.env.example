# Local captain (personal Jira) config — copy to .env and fill in (never commit .env).
# Completely separate from employer/work Jira. Do not reuse work credentials.

CAPTAIN_JIRA_URL=https://vainer-house.atlassian.net
CAPTAIN_JIRA_EMAIL=you@example.com
CAPTAIN_JIRA_API_TOKEN=

# Optional defaults
CAPTAIN_JIRA_PROJECT=CAPTAIN
CAPTAIN_JIRA_BOARD_ID=2
